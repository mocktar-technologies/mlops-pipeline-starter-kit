{
  "uid": "mlops-inference",
  "title": "MLOps: inference and model health",
  "description": "Four layers, top to bottom: what the service promised, what the application is doing, what data is arriving, and what the model is predicting. The two lower layers are the ones a traditional monitoring stack does not give you, and they are the reason a green infrastructure dashboard is not evidence that a model is working.",
  "tags": [
    "mlops",
    "inference",
    "model"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(inference_model_loaded, namespace)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "model_version",
        "label": "Model version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(inference_predictions_total{namespace=\"$namespace\"}, model_version)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Model version changes",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(timestamp(inference_model_info{namespace=\"$namespace\"})[5m:1m]) > 0",
        "titleFormat": "Model version change",
        "textFormat": "A different model version started reporting. Most latency and prediction changes on this dashboard should be read against these lines first."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Service level",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Model loaded",
      "description": "0 means the pod is serving HTTP with no model and returning 503 to every inference request. A readiness probe should already have removed it from the Service.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(inference_model_loaded{namespace=\"$namespace\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO MODEL",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "loaded",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Running model version",
      "description": "Read off inference_model_info, which the service reports from the same value its metrics are labelled with. Compare it with the champion alias in MLflow: the two disagreeing is the most common cause of a confusing dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_model_info{namespace=\"$namespace\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{model_version}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^model_version$/",
          "values": true
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "string"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(inference:request_rate:5m{namespace=\"$namespace\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Error ratio",
      "description": "Server-side failures as a share of requests. The alert threshold is 2 percent, tighter than a typical web service because an inference client usually has no retry and a failed prediction becomes a missing value in someone's decision.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(inference:error_ratio:5m{namespace=\"$namespace\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "p99 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(inference:latency_p99:5m{namespace=\"$namespace\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Application layer: the signals you already have",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by route and status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(inference_requests_total{namespace=\"$namespace\", model_version=~\"$model_version\"}[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*5xx.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Total latency against model latency",
      "description": "The useful comparison on this dashboard. When total p99 rises and model p99 does not, the extra time is outside the model: CPU throttling, a larger batch size, or contention on the node. Rolling back the model would change nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(inference:latency_p99:5m{namespace=\"$namespace\"})",
          "legendFormat": "total p99"
        },
        {
          "refId": "B",
          "expr": "max(inference:model_latency_p99:5m{namespace=\"$namespace\"})",
          "legendFormat": "model p99"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(inference_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "total p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "row",
      "title": "Data layer: what is arriving",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Rejected inputs by reason",
      "description": "A rise in reason=schema is the earliest signal that an upstream producer changed its output, and it appears here before any model metric moves. reason=batch_too_large is a client behaviour change and needs a conversation, not a fix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(inference_input_rejected_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Input drift by feature",
      "description": "Population stability index against the training reference. The conventional reading: below 0.10 no meaningful change, 0.10 to 0.25 worth investigating, above 0.25 a material shift. A heuristic, not a statistical test.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "model_drift_psi{namespace=\"$namespace\"}",
          "legendFormat": "{{feature}}"
        },
        {
          "refId": "B",
          "expr": "model_drift_threshold{namespace=\"$namespace\", level=\"alert\"}",
          "legendFormat": "alert threshold"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alert threshold"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Drift freshness",
      "description": "Seconds since the drift exporter last completed a computation. This panel exists because a drift gauge holding a stale healthy value looks exactly like a healthy system. Above the DriftMonitorStale threshold, treat every drift number here as unknown rather than as green.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(model_drift_last_success_timestamp_seconds{namespace=\"$namespace\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1200
              },
              {
                "color": "red",
                "value": 2100
              }
            ]
          },
          "noValue": "exporter not reporting"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Model layer: what is being predicted",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "heatmap",
      "title": "Prediction distribution",
      "description": "The cheapest early warning available. A model that has quietly started predicting near zero for everything still returns 200s in single-digit milliseconds, so every application panel above stays green. This one moves first.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(inference_prediction_bucket{namespace=\"$namespace\", model_version=~\"$model_version\"}[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "short",
          "decimals": 0
        },
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64
        },
        "cellGap": 1
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Mean prediction against the same window yesterday",
      "description": "The alert fires on a 25 percent divergence sustained for 30 minutes. Check the model version annotations before reading a divergence as drift: a deploy is the most common explanation and the least interesting one.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(inference:mean_prediction:30m{namespace=\"$namespace\"})",
          "legendFormat": "now"
        },
        {
          "refId": "B",
          "expr": "sum(inference:mean_prediction:30m{namespace=\"$namespace\"} offset 1d)",
          "legendFormat": "24h ago"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "24h ago"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Clamped predictions",
      "description": "This panel should be flat at zero forever. The exported graph ends in exp(), so a value outside the bounds is impossible, and a non-zero line here means the artifact in the pod is not the model this service was written for. It is a critical alert for that reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bound) (increase(inference_prediction_clamped_total{namespace=\"$namespace\"}[15m]))",
          "legendFormat": "{{bound}} bound"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Batch size distribution",
      "description": "Rows per request. A rise in p99 batch size explains a rise in p99 latency without anything being wrong with the model, which is worth knowing before you roll anything back.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(inference_batch_size_bucket{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(inference_batch_size_bucket{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Predictions per second by model version",
      "description": "Rows, not requests. During a canary this panel is how you confirm traffic is actually reaching the new version rather than trusting the rollout status.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_version) (rate(inference_predictions_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "version {{model_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Infrastructure layer",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU use against request and limit",
      "description": "The request is the denominator of the autoscaling decision, so a pod sitting permanently above it is a pod the HPA should have scaled out of. A pod pinned at its limit is being throttled, and throttling presents as tail latency with no rise in request rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container=\"inference\"}[5m]))",
          "legendFormat": "{{pod}}"
        },
        {
          "refId": "B",
          "expr": "avg(kube_pod_container_resource_requests{namespace=\"$namespace\", container=\"inference\", resource=\"cpu\"})",
          "legendFormat": "request"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "request"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Replicas and restarts",
      "description": "Ready against desired, with container restarts. A restart count that climbs while everything else looks healthy is usually an OOMKill, and the memory panel is where to look next.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"$namespace\", deployment=~\".*inference.*\"})",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "expr": "sum(kube_deployment_spec_replicas{namespace=\"$namespace\", deployment=~\".*inference.*\"})",
          "legendFormat": "desired"
        },
        {
          "refId": "C",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", container=\"inference\"}[15m]))",
          "legendFormat": "restarts (15m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "restarts (15m)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "GPU utilisation on the training node group",
      "description": "Empty when no training job is running, which is correct: the GPU node group scales to zero. If it is empty during a training run, the NVIDIA device plugin is not reporting and the job is probably running on CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"nvidia_com_gpu\"})",
          "legendFormat": "{{node}} allocatable GPUs"
        },
        {
          "refId": "B",
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"nvidia_com_gpu\"})",
          "legendFormat": "{{node}} requested GPUs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Monitoring health: is the monitoring itself working",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Drift sample sizes",
      "description": "A population stability index computed from a few hundred rows swings for reasons that have nothing to do with drift. If the window row count is near the exporter's 200-row floor, read the drift panels above as noise rather than as signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(model_drift_reference_rows{namespace=\"$namespace\"})",
          "legendFormat": "training reference rows"
        },
        {
          "refId": "B",
          "expr": "max(model_drift_window_rows{namespace=\"$namespace\"})",
          "legendFormat": "production window rows"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Drift computation time",
      "description": "Each cycle reads the recent window from S3, so this is a cost signal as much as a performance one. A duration that climbs steadily means the window is growing, and the exporter's window_rows cap is what bounds it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 51
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(model_drift_run_duration_seconds{namespace=\"$namespace\"})",
          "legendFormat": "last run"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "stat",
      "title": "Model load failures (1h)",
      "description": "Non-zero means a pod tried to load an artifact and could not. Look at the init container logs first: a failed fetch and a corrupt graph produce the same counter and very different fixes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 51
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(inference_model_load_failures_total{namespace=\"$namespace\"}[1h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}

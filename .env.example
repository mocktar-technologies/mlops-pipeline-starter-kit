# Local development environment.
#
# Copy to .env, which is gitignored. Every value here is a location or an
# identifier, not a credential, and that is deliberate:
#
#   AWS access        comes from your local profile or SSO session, never from a
#                     key in this file. `aws sso login` or `aws configure sso`.
#   Database password generated and rotated by RDS, read from Secrets Manager by
#                     the pod at start time. It is not in Terraform state, not in
#                     a manifest, and not here.
#   CI credentials    do not exist. GitHub Actions authenticates with OIDC.
#
# If you ever need to add a secret to this file, stop and check whether the thing
# consuming it could read it from Secrets Manager with an IRSA identity instead.
# That is almost always both easier and safer than distributing a key.

# ---------------------------------------------------------------------------
# Where things are. Fill these from: make outputs
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=

# terraform output -raw artifact_bucket
ARTIFACT_BUCKET=

# terraform output -raw mlflow_tracking_uri
# From a laptop, port-forward first:
#   kubectl -n mlflow port-forward svc/mlflow 5000:5000
# and then use http://localhost:5000 here.
MLFLOW_TRACKING_URI=http://localhost:5000

# A local path for offline work, or an s3:// URI for the real dataset.
#   make sample-data   generates data/sample.csv
DATA_URI=data/sample.csv

# ---------------------------------------------------------------------------
# Serving, for `make serve-local`
# ---------------------------------------------------------------------------
MODEL_PATH=artifacts/local/model.onnx
MODEL_NAME=demand-forecast
# Set this to something recognisable. Every metric the service emits is labelled
# with it, and "unknown" makes a latency or accuracy change unattributable.
MODEL_VERSION=local
SERVING_PORT=8080
LOG_LEVEL=info
# Keep this at or below the CPU you give the container. ONNX Runtime otherwise
# sizes its thread pool from the host core count and the threads contend.
SERVING_INTRA_OP_THREADS=1

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
# Recorded as a tag on every MLflow run, so a model can be traced to a commit.
GIT_SHA=
